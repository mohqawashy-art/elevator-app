# LiftCore — متغيرات البيئة (نسخ إلى .env أو /etc/liftcore/platform.env)

# مطلوب في الإنتاج (LIFTCORE_HTTPS=1)
SECRET_KEY=generate-a-long-random-string-here

# قاعدة البيانات
# محلي: SQLite تلقائي (instance/liftcore.db)
# إنتاج: PostgreSQL موصى به — راجع deploy/POSTGRES.md
# DATABASE_URL=postgresql://liftcore:PASSWORD@127.0.0.1:5432/liftcore

# HTTPS / الإنتاج
LIFTCORE_HTTPS=1

# Google Maps (مستوى المنصة — لا تضف المفتاح في الكود)
GOOGLE_MAPS_API_KEY=

# موديول التركيب على السيرفر (0=معطّل، 1=مفعّل)
# LIFTCORE_INSTALL_MODULE=0

# أمان — محاولات الدخول
# LIFTCORE_LOGIN_MAX_ATTEMPTS=5
# LIFTCORE_LOGIN_WINDOW_SEC=900
# LIFTCORE_LOGIN_LOCKOUT_SEC=900
# LIFTCORE_FIELD_PIN_MAX_ATTEMPTS=5

# رفع الملفات — حد MB
# LIFTCORE_MAX_UPLOAD_MB=10

# إصدار العرض (اختياري)
# LIFTCORE_VERSION=

# مراقبة الأخطاء — Sentry (اختياري في الإنتاج)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=liftcore@1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0
