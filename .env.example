# LiftCore / جما — نسخ هذا الملف إلى .env في جذر المشروع
# (نفس المجلد الذي فيه app.py)

# === Google Maps (مهم لجما على اللاب توب) ===
# انسخ نفس القيمة من سيرفر LiftCore:
#   cat ~/liftcore/elevator-app/.env | grep GOOGLE_MAPS
GOOGLE_MAPS_API_KEY=

