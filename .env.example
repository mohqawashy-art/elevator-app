# LiftCore — متغيرات البيئة (نسخ إلى .env أو /etc/liftcore/platform.env)

# مطلوب في الإنتاج (LIFTCORE_HTTPS=1)
SECRET_KEY=generate-a-long-random-string-here

# قاعدة البيانات
# محلي: SQLite تلقائي (instance/liftcore.db)
# إنتاج: PostgreSQL موصى به — راجع deploy/POSTGRES.md
# DATABASE_URL=postgresql://liftcore:PASSWORD@127.0.0.1:5432/liftcore

# HTTPS / الإنتاج
LIFTCORE_HTTPS=1

# Google Maps (مستوى المنصة — لا تضف المفتاح في الكود)
GOOGLE_MAPS_API_KEY=

# موديول التركيب على السيرفر (0=معطّل، 1=مفعّل)
# LIFTCORE_INSTALL_MODULE=0

# أمان — محاولات الدخول
# LIFTCORE_LOGIN_MAX_ATTEMPTS=5
# LIFTCORE_LOGIN_WINDOW_SEC=900
# LIFTCORE_LOGIN_LOCKOUT_SEC=900
# LIFTCORE_FIELD_PIN_MAX_ATTEMPTS=5

# رفع الملفات — حد MB
# LIFTCORE_MAX_UPLOAD_MB=10

# تسجيل مؤسسات جديدة (أسبوع 7 — معطّل افتراضياً حتى الـ cutover)
# LIFTCORE_SIGNUP_ENABLED=1
# LIFTCORE_TRIAL_DAYS=14
# MAIL_API_KEY=re_...   # Resend — اختياري
# MAIL_FROM=noreply@liftcoreapp.com

# دعوات انضمام العملاء (مشغّل المنصة على app / default)
# LIFTCORE_OPERATOR_ORGS=default
# LIFTCORE_INVITE_DAYS=14
# LIFTCORE_PUBLIC_BASE=https://liftcoreapp.com

# لوحة إدارة المنصة: https://admin.liftcoreapp.com
# (wildcard DNS يغطي admin تلقائياً إن كان *.liftcoreapp.com موجوداً)

# صلاحيات اختيارية per-user (أو من الإعدادات → المستخدمون)
# LIFTCORE_CUSTOM_PERMISSIONS=1

# مراقبة الأخطاء — Sentry (اختياري في الإنتاج)
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=production
# SENTRY_RELEASE=liftcore@1.0.0
# SENTRY_TRACES_SAMPLE_RATE=0
