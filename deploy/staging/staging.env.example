# انسخ إلى /etc/liftcore/staging.env ولا تضع القيم الحقيقية في Git.
SECRET_KEY=CHANGE_ME
DATABASE_URL=postgresql+psycopg://liftcore_staging:CHANGE_ME@127.0.0.1:5432/liftcore_staging
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=liftcore_staging
PGUSER=liftcore_staging
PGPASSWORD=CHANGE_ME

LIFTCORE_ENV=staging
LIFTCORE_PUBLIC_BASE=https://test.liftcoreapp.com
LIFTCORE_HTTPS=1
LIFTCORE_INSTALL_MODULE=1
LIFTCORE_SIGNUP_ENABLED=0
LIFTCORE_ZATCA_MOCK=1
SENTRY_ENVIRONMENT=staging

# خدمات خارجية معطلة افتراضياً في التجربة.
MAIL_API_KEY=
MAIL_FROM=
MOYASAR_SECRET_KEY=
MOYASAR_PUBLISHABLE_KEY=
WHATSAPP_VERIFY_TOKEN=
SENTRY_DSN=
LIFTCORE_GTAG_ID=
