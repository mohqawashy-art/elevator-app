# تجربة test.liftcoreapp.com — معزولة عن الإنتاج (منفذ 5003)
# خلف Cloudflare: شهادة Origin على 443

server {
    listen 80;
    listen [::]:80;
    server_name test.liftcoreapp.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name test.liftcoreapp.com;

    ssl_certificate     /etc/ssl/certs/liftcore-origin.crt;
    ssl_certificate_key /etc/ssl/private/liftcore-origin.key;
    ssl_protocols       TLSv1.2 TLSv1.3;

    client_max_body_size 20M;
    add_header X-Robots-Tag "noindex, nofollow, noarchive" always;

    location = /robots.txt {
        default_type text/plain;
        return 200 "User-agent: *\nDisallow: /\n";
    }

    auth_basic "LiftCore staging";
    auth_basic_user_file /etc/nginx/.htpasswd-liftcore-staging;

    location / {
        proxy_pass http://127.0.0.1:5003;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
