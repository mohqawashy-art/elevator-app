# منصة LiftCore — إعدادات مشتركة لكل العملاء (LiftCore + جما + ...)
# انسخ إلى /etc/liftcore/platform.env على السيرفر (مرة واحدة)
#
#   sudo mkdir -p /etc/liftcore
#   sudo cp deploy/platform.env.example /etc/liftcore/platform.env
#   sudo nano /etc/liftcore/platform.env
#   bash deploy/check_platform_env.sh
#   sudo systemctl restart liftcore

SECRET_KEY=
LIFTCORE_HTTPS=1
GOOGLE_MAPS_API_KEY=

# بريد المنصة عبر Resend (دعوات / ترحيب / إشعارات)
# 1) أنشئ حساباً: https://resend.com
# 2) Domains → Add Domain → liftcoreapp.com
# 3) أضف سجلات DNS التي يعرضها Resend (DKIM + SPF) في Cloud DNS
# 4) انتظر Verify → انسخ API Key هنا
MAIL_API_KEY=
MAIL_FROM=LiftCore <noreply@liftcoreapp.com>

# دعم داخل التطبيق (أيقونة عائمة للمستخدمين المسجّلين)
LIFTCORE_SUPPORT_EMAIL=info@liftcoreapp.com
LIFTCORE_SUPPORT_WHATSAPP=0566299626

# بريد المبيعات (صفحات التعريف والأسعار / تواصل العملاء المحتملين)
LIFTCORE_SALES_EMAIL=sales@liftcoreapp.com

# Google Ads / Analytics (صفحة /start — انظر docs/marketing/ADS.md)
# الوسم AW-18388162918 مضمّن في صفحات التسويق افتراضياً.
# LIFTCORE_GTAG_ID=AW-18388162918
# LIFTCORE_ADS_CONVERSION_ID=AW-18388162918
# LIFTCORE_ADS_CONVERSION_LABEL=

# مدة حسابات الديمو الصادرة من لوحة المنصة (أيام)
# LIFTCORE_DEMO_DAYS=7

# صفحة الأسعار بدل «قريباً» على liftcoreapp.com (اتركها 1 حتى يُفتح التسجيل)
LIFTCORE_COMING_SOON=1
# LIFTCORE_SIGNUP_ENABLED=1

# رابط دعوات العملاء (/onboard/*) — النطاق التسويقي فقط
# LIFTCORE_INVITE_BASE=https://liftcoreapp.com
# LIFTCORE_PUBLIC_BASE=https://app.liftcoreapp.com

# Rate limit: افتراضي = جدول DB مشترك بين gunicorn workers
# LIFTCORE_RATE_LIMIT_STORE=memory
# LIFTCORE_LOGIN_MAX_ATTEMPTS=5
# LIFTCORE_LOGIN_WINDOW_SEC=900
# LIFTCORE_LOGIN_LOCKOUT_SEC=900
